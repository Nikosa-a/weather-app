<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Weather App </title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- FontAwesome İkonları için -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
        }

        .container {
            width: 100%;
            max-width: 420px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        }

        .search-box {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
        }

        .search-box input {
            flex: 1;
            padding: 12px 18px;
            border: none;
            outline: none;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 16px;
        }

        .search-box input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .search-box button {
            padding: 0 20px;
            border: none;
            outline: none;
            background: #00c6ff;
            color: #fff;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
            font-size: 16px;
        }

        .search-box button:hover {
            background: #0072ff;
        }

        .weather-card {
            text-align: center;
            display: none;
        }

        .weather-card.active {
            display: block;
        }

        .location {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .temp-icon img {
            width: 100px;
            height: 100px;
        }

        .temperature {
            font-size: 48px;
            font-weight: 600;
            margin: 10px 0;
        }

        .description {
            font-size: 18px;
            text-transform: capitalize;
            margin-bottom: 25px;
            color: rgba(255, 255, 255, 0.9);
        }

        .details {
            display: flex;
            justify-content: space-between;
            background: rgba(0, 0, 0, 0.2);
            padding: 15px;
            border-radius: 12px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 14px;
            gap: 5px;
        }

        .detail-item i {
            font-size: 18px;
            color: #00c6ff;
        }

        .error-message {
            color: #ff6b6b;
            text-align: center;
            margin-top: 15px;
            font-weight: 500;
            display: none;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Arama Alanı -->
        <div class="search-box">
            <input type="text" id="cityInput" placeholder="Şehir adı girin...">
            <button id="searchBtn"><i class="fas fa-search"></i></button>
        </div>

        <!-- Hata Mesajı -->
        <div id="errorMsg" class="error-message">Şehir bulunamadı, lütfen tekrar deneyin.</div>

        <!-- Hava Durumu Bilgi Kartı -->
        <div id="weatherCard" class="weather-card">
            <div class="location" id="cityName">Sakarya, TR</div>
            <div class="temp-icon">
                <img id="weatherIcon" src="" alt="Hava Durumu İkonu">
            </div>
            <div class="temperature" id="tempValue">--°C</div>
            <div class="description" id="descValue">Parçalı Bulutlu</div>

            <div class="details">
                <div class="detail-item">
                    <i class="fas fa-tint"></i>
                    <span>Nem</span>
                    <strong id="humidityValue">--%</strong>
                </div>
                <div class="detail-item">
                    <i class="fas fa-wind"></i>
                    <span>Rüzgar</span>
                    <strong id="windValue">-- km/s</strong>
                </div>
            </div>
        </div>
    </div>

    <script>
        const apiKey = "ada76eb155c2890b0caec2be252f0ff8"; //
        const cityInput = document.getElementById('cityInput');
        const searchBtn = document.getElementById('searchBtn');
        const weatherCard = document.getElementById('weatherCard');
        const errorMsg = document.getElementById('errorMsg');

        const cityName = document.getElementById('cityName');
        const weatherIcon = document.getElementById('weatherIcon');
        const tempValue = document.getElementById('tempValue');
        const descValue = document.getElementById('descValue');
        const humidityValue = document.getElementById('humidityValue');
        const windValue = document.getElementById('windValue');

        // Butona veya Enter tuşuna basıldığında tetikleme
        searchBtn.addEventListener('click', () => {
            const city = cityInput.value.trim();
            if (city !== "") {
                getWeatherData(city);
            }
        });

        cityInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                const city = cityInput.value.trim();
                if (city !== "") {
                    getWeatherData(city);
                }
            }
        });

        // Asenkron API İstek Fonksiyonu
        async function getWeatherData(city) {
            try {
                errorMsg.style.display = "none";
                const response = await fetch(`https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&lang=tr&appid=${apiKey}`);
                
                if (!response.ok) {
                    throw new Error("Şehir bulunamadı");
                }

                const data = await response.json();
                
                // Verileri HTML elementlerine aktarma (DOM Manipulation)
                cityName.innerText = `${data.name}, ${data.sys.country}`;
                tempValue.innerText = `${Math.round(data.main.temp)}°C`;
                descValue.innerText = data.weather[0].description;
                humidityValue.innerText = `${data.main.humidity}%`;
                windValue.innerText = `${data.wind.speed} km/s`;
                
                // Hava durumu ikonunu dinamik olarak çekme
                const iconCode = data.weather[0].icon;
                weatherIcon.src = `https://openweathermap.org/img/wn/${iconCode}@2x.png`;

                // Kartı görünür yap
                weatherCard.classList.add('active');

            } catch (error) {
                weatherCard.classList.remove('active');
                errorMsg.style.display = "block";
            }
        }
    </script>
</body>
</html>

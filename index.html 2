<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nikosa Weather</title>
    <!-- FontAwesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", "Helvetica Neue", sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        :root {
            --glass-bg: rgba(255, 255, 255, 0.12);
            --glass-border: rgba(255, 255, 255, 0.18);
            --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.25);
            --text-primary: #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.65);
            --accent-yellow: #ffcc00;
        }

        body {
            min-height: 100vh;
            color: var(--text-primary);
            background: #111827;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 20px 10px;
            overflow-x: hidden;
            position: relative;
        }

        /* Canvas Arka Plan Animasyonu */
        #weather-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
            transition: opacity 1s ease;
        }

        /* Dinamik Arka Plan Gradient Geçişleri */
        .bg-gradient-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            transition: background 1.2s ease-in-out;
            background: linear-gradient(180deg, #1f293d 0%, #111827 100%);
        }

        .theme-clear-day { background: linear-gradient(180deg, #3a88e9 0%, #5ea4ff 50%, #a1caff 100%); }
        .theme-clear-night { background: linear-gradient(180deg, #0b1329 0%, #162447 60%, #1f4068 100%); }
        .theme-clouds-day { background: linear-gradient(180deg, #51637a 0%, #6d8299 50%, #8ca1b9 100%); }
        .theme-clouds-night { background: linear-gradient(180deg, #151d2a 0%, #222d3d 100%); }
        .theme-rain { background: linear-gradient(180deg, #2b333e 0%, #1c232d 100%); }
        .theme-snow { background: linear-gradient(180deg, #4b5d6e 0%, #7d8f9f 100%); }
        .theme-thunder { background: linear-gradient(180deg, #1a1a2e 0%, #0f0f1a 100%); }

        /* Ana Uygulama Konteyneri */
        .app-container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding-bottom: 40px;
        }

        /* Header & Search Bar */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .brand-title {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .search-box {
            position: relative;
            flex: 1;
            display: flex;
            align-items: center;
        }

        .search-box input {
            width: 100%;
            padding: 10px 38px 10px 14px;
            border-radius: 20px;
            border: 1px solid var(--glass-border);
            background: rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            color: #fff;
            font-size: 0.9rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .search-box input:focus {
            background: rgba(0, 0, 0, 0.4);
            border-color: rgba(255, 255, 255, 0.4);
        }

        .search-box input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .search-btn {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.7);
            cursor: pointer;
            font-size: 0.9rem;
        }

        .btn-icon-only {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1px solid var(--glass-border);
            background: rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(12px);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-icon-only:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* Cam Kart Stili (Glassmorphism) */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid var(--glass-border);
            border-radius: 22px;
            padding: 18px;
            box-shadow: var(--glass-shadow);
        }

        /* Ana Hava Durumu Özeti */
        .main-weather {
            text-align: center;
            padding: 24px 10px 10px 10px;
        }

        .location-name {
            font-size: 2rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }

        .temp-display {
            font-size: 5.5rem;
            font-weight: 200;
            margin: -5px 0 -10px 0;
            letter-spacing: -2px;
            text-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }

        .weather-desc {
            font-size: 1.2rem;
            font-weight: 500;
            text-transform: capitalize;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 6px;
        }

        .high-low {
            font-size: 0.95rem;
            font-weight: 500;
            color: var(--text-secondary);
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        /* Kart Başlıkları */
        .card-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding-bottom: 8px;
        }

        /* Saatlik Tahmin Yatay Liste */
        .hourly-scroll {
            display: flex;
            overflow-x: auto;
            gap: 18px;
            padding-bottom: 6px;
            scrollbar-width: none;
        }

        .hourly-scroll::-webkit-scrollbar {
            display: none;
        }

        .hourly-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            min-width: 48px;
        }

        .hourly-time {
            font-size: 0.85rem;
            font-weight: 500;
        }

        .hourly-icon {
            font-size: 1.3rem;
            height: 28px;
            display: flex;
            align-items: center;
        }

        .hourly-temp {
            font-size: 0.95rem;
            font-weight: 600;
        }

        /* 5 Günlük Tahmin Listesi */
        .daily-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .daily-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.95rem;
            font-weight: 500;
        }

        .daily-day {
            width: 65px;
        }

        .daily-icon {
            width: 30px;
            text-align: center;
            font-size: 1.1rem;
        }

        .daily-temp-bar-container {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 12px;
        }

        .temp-low-text {
            color: var(--text-secondary);
            width: 28px;
            text-align: right;
        }

        .temp-bar-bg {
            flex: 1;
            height: 4px;
            background: rgba(0, 0, 0, 0.25);
            border-radius: 4px;
            position: relative;
            overflow: hidden;
        }

        .temp-bar-fill {
            position: absolute;
            height: 100%;
            border-radius: 4px;
            background: linear-gradient(90deg, #96deda 0%, #50cc7f 50%, #ffcc00 100%);
        }

        .temp-high-text {
            width: 28px;
        }

        /* 2'li Grid Detay Kartları */
        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .detail-card-val {
            font-size: 1.6rem;
            font-weight: 600;
            margin: 6px 0 4px 0;
        }

        .detail-card-sub {
            font-size: 0.78rem;
            color: var(--text-secondary);
            line-height: 1.2;
        }

        /* SVG / Font İkon Renk Özelleştirmeleri */
        .icon-sun { color: #ffd15c; }
        .icon-cloud { color: #d0d7de; }
        .icon-rain { color: #64b5f6; }
        .icon-snow { color: #e0f7fa; }
        .icon-thunder { color: #ffb74d; }

        /* Yükleniyor Göstergesi */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(10px);
            z-index: 99;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 12px;
            transition: opacity 0.4s ease;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255,255,255,0.2);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>

    <!-- Yüklenme Ekranı -->
    <div id="loading" class="loading-overlay">
        <div class="spinner"></div>
        <span style="font-size:0.9rem; font-weight:500;">Hava Durumu Yükleniyor...</span>
    </div>

    <!-- Dinamik Arka Plan Tuvali & Katmanları -->
    <div id="bg-overlay" class="bg-gradient-overlay"></div>
    <canvas id="weather-canvas"></canvas>

    <!-- Ana Uygulama İçeriği -->
    <div class="app-container">

        <!-- Üst Bar & Arama -->
        <header class="header">
            <div class="brand-title">
                <i class="fa-solid fa-cloud-bolt icon-thunder"></i> Nikosa
            </div>
            
            <div class="search-box">
                <input type="text" id="city-input" placeholder="Şehir ara..." autocomplete="off">
                <button class="search-btn" id="search-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>

            <button class="btn-icon-only" id="geo-btn" title="Mevcut Konum">
                <i class="fa-solid fa-location-crosshairs"></i>
            </button>
            <button class="btn-icon-only" id="unit-toggle-btn" title="Birim Değiştir">
                °C
            </button>
        </header>

        <!-- Ana Hava Durumu Kartı -->
        <section class="main-weather">
            <div class="location-name" id="city-name">
                <i class="fa-solid fa-location-dot" style="font-size:1.2rem; opacity:0.8;"></i> Yükleniyor...
            </div>
            <div class="temp-display" id="temp-val">--°</div>
            <div class="weather-desc" id="weather-desc">--</div>
            <div class="high-low">
                <span id="temp-max">Y: --°</span>
                <span id="temp-min">A: --°</span>
            </div>
        </section>

        <!-- Saatlik Tahmin Kartı -->
        <section class="glass-card">
            <div class="card-header">
                <i class="fa-regular fa-clock"></i> Saatlik Tahmin
            </div>
            <div class="hourly-scroll" id="hourly-container">
                <!-- JS ile Doldurulacak -->
            </div>
        </section>

        <!-- 5 Günlük Tahmin Kartı -->
        <section class="glass-card">
            <div class="card-header">
                <i class="fa-regular fa-calendar-days"></i> 5 Günlük Tahmin
            </div>
            <div class="daily-list" id="daily-container">
                <!-- JS ile Doldurulacak -->
            </div>
        </section>

        <!-- Detay Metrik Kartları (Grid 2x3) -->
        <div class="details-grid">
            <div class="glass-card">
                <div class="card-header">
                    <i class="fa-solid fa-temperature-three-quarters"></i> Hissedilen
                </div>
                <div class="detail-card-val" id="feels-like">--°</div>
                <div class="detail-card-sub" id="feels-like-sub">Rüzgar etkisiyle aynı hissediliyor.</div>
            </div>

            <div class="glass-card">
                <div class="card-header">
                    <i class="fa-solid fa-droplet"></i> Nem
                </div>
                <div class="detail-card-val" id="humidity">--%</div>
                <div class="detail-card-sub" id="humidity-sub">Çiy noktası şu an --° civarında.</div>
            </div>

            <div class="glass-card">
                <div class="card-header">
                    <i class="fa-solid fa-wind"></i> Rüzgar
                </div>
                <div class="detail-card-val" id="wind-speed">-- km/s</div>
                <div class="detail-card-sub" id="wind-dir">Yön: --</div>
            </div>

            <div class="glass-card">
                <div class="card-header">
                    <i class="fa-solid fa-gauge-high"></i> Basınç
                </div>
                <div class="detail-card-val" id="pressure">-- hPa</div>
                <div class="detail-card-sub">Standart atmosferik basınç.</div>
            </div>

            <div class="glass-card">
                <div class="card-header">
                    <i class="fa-solid fa-eye"></i> Görüş Mesafesi
                </div>
                <div class="detail-card-val" id="visibility">-- km</div>
                <div class="detail-card-sub" id="vis-sub">Mükemmel netlikte görüş.</div>
            </div>

            <div class="glass-card">
                <div class="card-header">
                    <i class="fa-solid fa-sun"></i> Gün Doğumu
                </div>
                <div class="detail-card-val" id="sunrise-time">--:--</div>
                <div class="detail-card-sub" id="sunset-time">Batış: --:--</div>
            </div>
        </div>

    </div>

    <!-- Uygulama Mantığı & Weather Canvas Animasyon Engine -->
    <script>
        const API_KEY = "ada76eb155c2890b0caec2be252f0ff8"; // Entegre Edilen API Anahtarı
        let currentUnit = "metric"; // metric (C) veya imperial (F)
        let lastQueryCity = "Sakarya";

        // DOM Elementleri
        const cityInput = document.getElementById("city-input");
        const searchBtn = document.getElementById("search-btn");
        const geoBtn = document.getElementById("geo-btn");
        const unitToggleBtn = document.getElementById("unit-toggle-btn");
        const loadingOverlay = document.getElementById("loading");
        const bgOverlay = document.getElementById("bg-overlay");

        // Hava Durumu İkon Haritası (FontAwesome)
        function getWeatherIconClass(code, isNight = false) {
            if (code >= 200 && code < 300) return "fa-solid fa-cloud-bolt icon-thunder";
            if (code >= 300 && code < 600) return "fa-solid fa-cloud-showers-heavy icon-rain";
            if (code >= 600 && code < 700) return "fa-solid fa-snowflake icon-snow";
            if (code >= 700 && code < 800) return "fa-solid fa-smog icon-cloud";
            if (code === 800) return isNight ? "fa-solid fa-moon icon-cloud" : "fa-solid fa-sun icon-sun";
            if (code > 800) return isNight ? "fa-solid fa-cloud-moon icon-cloud" : "fa-solid fa-cloud-sun icon-cloud";
            return "fa-solid fa-cloud icon-cloud";
        }

        // --- 1. API VERİ ÇEKME FONKSİYONLARI ---
        async function fetchWeatherData(query) {
            showLoading(true);
            try {
                let url = "";
                if (typeof query === "string") {
                    url = `https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(query)}&units=${currentUnit}&lang=tr&appid=${API_KEY}`;
                } else if (query.lat && query.lon) {
                    url = `https://api.openweathermap.org/data/2.5/weather?lat=${query.lat}&lon=${query.lon}&units=${currentUnit}&lang=tr&appid=${API_KEY}`;
                }

                const res = await fetch(url);
                if (!res.ok) throw new Error("Şehir bulunamadı.");
                const data = await res.json();

                // 5 Günlük & Saatlik Tahmin İçin Forecast API Çağrısı
                const forecastRes = await fetch(`https://api.openweathermap.org/data/2.5/forecast?lat=${data.coord.lat}&lon=${data.coord.lon}&units=${currentUnit}&lang=tr&appid=${API_KEY}`);
                const forecastData = await forecastRes.json();

                lastQueryCity = data.name;
                updateUI(data, forecastData);
            } catch (err) {
                alert("Hata: " + err.message);
            } finally {
                showLoading(false);
            }
        }

        function showLoading(show) {
            if (show) loadingOverlay.classList.remove("hidden");
            else loadingOverlay.classList.add("hidden");
        }

        // --- 2. ARAYÜZ (UI) GÜNCELLEME ---
        function updateUI(current, forecast) {
            const isImperial = currentUnit === "imperial";
            const unitSymbol = isImperial ? "°F" : "°C";
            const speedSymbol = isImperial ? "mph" : "km/s";

            // Gece / Gündüz Tespiti
            const now = current.dt;
            const isNight = now < current.sys.sunrise || now > current.sys.sunset;

            // Ana Kart
            document.getElementById("city-name").innerHTML = `<i class="fa-solid fa-location-dot" style="font-size:1.2rem; opacity:0.8;"></i> ${current.name}, ${current.sys.country}`;
            document.getElementById("temp-val").textContent = `${Math.round(current.main.temp)}°`;
            document.getElementById("weather-desc").textContent = current.weather[0].description;
            document.getElementById("temp-max").textContent = `Y: ${Math.round(current.main.temp_max)}°`;
            document.getElementById("temp-min").textContent = `A: ${Math.round(current.main.temp_min)}°`;

            // Detay Kartları
            document.getElementById("feels-like").textContent = `${Math.round(current.main.feels_like)}°`;
            document.getElementById("humidity").textContent = `${current.main.humidity}%`;
            document.getElementById("wind-speed").textContent = `${Math.round(current.wind.speed * (isImperial ? 1 : 3.6))} ${speedSymbol}`;
            document.getElementById("wind-dir").textContent = `Yön: ${getWindDirection(current.wind.deg)}`;
            document.getElementById("pressure").textContent = `${current.main.pressure} hPa`;
            
            const visKm = (current.visibility / 1000).toFixed(1);
            document.getElementById("visibility").textContent = `${visKm} km`;
            document.getElementById("vis-sub").textContent = visKm > 8 ? "Görüş mesafesi çok iyi." : "Hafif pus veya sis var.";

            document.getElementById("sunrise-time").textContent = formatUnixTime(current.sys.sunrise, current.timezone);
            document.getElementById("sunset-time").textContent = `Batış: ${formatUnixTime(current.sys.sunset, current.timezone)}`;

            // Saatlik Tahmin
            const hourlyContainer = document.getElementById("hourly-container");
            hourlyContainer.innerHTML = "";
            forecast.list.slice(0, 10).forEach(item => {
                const itemIsNight = item.sys.pod === 'n';
                const div = document.createElement("div");
                div.className = "hourly-item";
                div.innerHTML = `
                    <span class="hourly-time">${formatUnixTime(item.dt, forecast.city.timezone, true)}</span>
                    <div class="hourly-icon"><i class="${getWeatherIconClass(item.weather[0].id, itemIsNight)}"></i></div>
                    <span class="hourly-temp">${Math.round(item.main.temp)}°</span>
                `;
                hourlyContainer.appendChild(div);
            });

            // 5 Günlük Tahmin
            const dailyContainer = document.getElementById("daily-container");
            dailyContainer.innerHTML = "";
            const dailyData = extractDailyForecast(forecast.list);
            
            dailyData.forEach(day => {
                const div = document.createElement("div");
                div.className = "daily-item";
                div.innerHTML = `
                    <span class="daily-day">${day.dayName}</span>
                    <div class="daily-icon"><i class="${getWeatherIconClass(day.iconCode)}"></i></div>
                    <div class="daily-temp-bar-container">
                        <span class="temp-low-text">${Math.round(day.tempMin)}°</span>
                        <div class="temp-bar-bg">
                            <div class="temp-bar-fill" style="left:20%; width:60%;"></div>
                        </div>
                        <span class="temp-high-text">${Math.round(day.tempMax)}°</span>
                    </div>
                `;
                dailyContainer.appendChild(div);
            });

            // Tema ve Arka Plan Animasyonu Değişimi
            setThemeAndAnimation(current.weather[0].id, isNight);
        }

        // --- 3. TEMA VE CANVAS ANIMASYON MOTORU ---
        function setThemeAndAnimation(weatherCode, isNight) {
            bgOverlay.className = "bg-gradient-overlay"; // Reset

            let mode = "clear";
            if (weatherCode >= 200 && weatherCode < 300) mode = "thunder";
            else if (weatherCode >= 300 && weatherCode < 600) mode = "rain";
            else if (weatherCode >= 600 && weatherCode < 700) mode = "snow";
            else if (weatherCode >= 700 && weatherCode < 800) mode = "clouds";
            else if (weatherCode === 800) mode = isNight ? "clear-night" : "clear-day";
            else if (weatherCode > 800) mode = isNight ? "clouds-night" : "clouds-day";

            bgOverlay.classList.add(`theme-${mode}`);
            startCanvasAnimation(mode);
        }

        // Canvas Yağmur/Kar/Bulut Parçacık Animasyonları
        const canvas = document.getElementById("weather-canvas");
        const ctx = canvas.getContext("2d");
        let animationFrameId;
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener("resize", resizeCanvas);
        resizeCanvas();

        function startCanvasAnimation(type) {
            cancelAnimationFrame(animationFrameId);
            particles = [];
            const count = type.includes("rain") || type.includes("thunder") ? 140 : (type.includes("snow") ? 90 : 35);

            for (let i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    length: Math.random() * 20 + 10,
                    speed: Math.random() * 10 + 5,
                    radius: Math.random() * 3 + 1,
                    opacity: Math.random() * 0.5 + 0.2
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                if (type.includes("rain") || type.includes("thunder")) {
                    ctx.strokeStyle = "rgba(174, 194, 224, 0.5)";
                    ctx.lineWidth = 1.2;
                    particles.forEach(p => {
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(p.x - 2, p.y + p.length);
                        ctx.stroke();

                        p.y += p.speed * 1.5;
                        p.x -= 0.5;
                        if (p.y > canvas.height) {
                            p.y = -20;
                            p.x = Math.random() * canvas.width;
                        }
                    });
                } else if (type.includes("snow")) {
                    ctx.fillStyle = "rgba(255, 255, 255, 0.8)";
                    particles.forEach(p => {
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                        ctx.fill();

                        p.y += p.speed * 0.25;
                        p.x += Math.sin(p.y * 0.02);
                        if (p.y > canvas.height) {
                            p.y = -10;
                            p.x = Math.random() * canvas.width;
                        }
                    });
                } else {
                    // Güneşli veya bulutlu hafif süzülen toz/ışık taneleri
                    ctx.fillStyle = "rgba(255, 255, 255, 0.25)";
                    particles.forEach(p => {
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.radius * 1.5, 0, Math.PI * 2);
                        ctx.fill();

                        p.y -= p.speed * 0.1;
                        if (p.y < -10) {
                            p.y = canvas.height + 10;
                            p.x = Math.random() * canvas.width;
                        }
                    });
                }

                animationFrameId = requestAnimationFrame(draw);
            }
            draw();
        }

        // --- YARDIMCI MANTIKLAR ---
        function extractDailyForecast(list) {
            const daysMap = {};
            list.forEach(item => {
                const date = new Date(item.dt * 1000);
                const dayName = date.toLocaleDateString("tr-TR", { weekday: "short" });
                if (!daysMap[dayName]) {
                    daysMap[dayName] = { dayName, tempMin: item.main.temp_min, tempMax: item.main.temp_max, iconCode: item.weather[0].id };
                } else {
                    if (item.main.temp_min < daysMap[dayName].tempMin) daysMap[dayName].tempMin = item.main.temp_min;
                    if (item.main.temp_max > daysMap[dayName].tempMax) daysMap[dayName].tempMax = item.main.temp_max;
                }
            });
            return Object.values(daysMap).slice(0, 5);
        }

        function formatUnixTime(dt, timezoneOffset, hoursOnly = false) {
            const date = new Date((dt + timezoneOffset) * 1000 - (new Date().getTimezoneOffset() * 60000));
            if (hoursOnly) return date.toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
            return date.toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
        }

        function getWindDirection(deg) {
            const dirs = ["K", "KD", "D", "GD", "K", "GB", "B", "KB"];
            return dirs[Math.round(deg / 45) % 8];
        }

        // --- EVENT LISTENERS ---
        searchBtn.addEventListener("click", () => {
            const q = cityInput.value.trim();
            if (q) fetchWeatherData(q);
        });

        cityInput.addEventListener("keypress", (e) => {
            if (e.key === "Enter") {
                const q = cityInput.value.trim();
                if (q) fetchWeatherData(q);
            }
        });

        geoBtn.addEventListener("click", () => {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (pos) => fetchWeatherData({ lat: pos.coords.latitude, lon: pos.coords.longitude }),
                    () => alert("Konum erişimi reddedildi.")
                );
            }
        });

        unitToggleBtn.addEventListener("click", () => {
            currentUnit = currentUnit === "metric" ? "imperial" : "metric";
            unitToggleBtn.textContent = currentUnit === "metric" ? "°C" : "°F";
            fetchWeatherData(lastQueryCity);
        });

        // Başlangıçta Sakarya Verisini Yükle
        fetchWeatherData(lastQueryCity);
    </script>
